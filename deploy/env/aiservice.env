# AIService runtime env vars
APP_ENV=prod
LOG_LEVEL=INFO
AI_LOG_DIR=/app/AIlog

REDIS_HOST=pet-redis
REDIS_PORT=6379
REDIS_DB=0
MEMORY_MAX_MESSAGES=8
MEMORY_TTL_SECONDS=86400

DASHSCOPE_API_KEY=please-set-your-dashscope-key
DASHSCOPE_BASE_URL=
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_SECONDS=30

SYSTEM_PROMPT_FILE=/app/ai_service/prompts/system_prompt.md
