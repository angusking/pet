# AIService runtime env vars
APP_ENV=prod
LOG_LEVEL=INFO
AI_LOG_DIR=/app/AIlog

REDIS_HOST=pet-redis
REDIS_PORT=6379
REDIS_DB=0
BACKEND_BASE_URL=http://pet-backend:8080
BACKEND_TIMEOUT_SECONDS=5
MEMORY_MAX_MESSAGES=8
MEMORY_TTL_SECONDS=86400

DASHSCOPE_API_KEY=please-set-your-dashscope-key
DASHSCOPE_BASE_URL=
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_SECONDS=30
AMAP_WEB_SERVICE_KEY=please-set-your-amap-key
AMAP_BASE_URL=https://restapi.amap.com
AMAP_SEARCH_PAGE_SIZE=5

RAG_ENABLED=true
RAG_DATA_DIR=/app/data
RAG_ACTIVE_FILE=/app/data/active_kb.json
RAG_KNOWLEDGE_DIR=/app/data/knowledge
RAG_INDEX_DIR=/app/data/indexes
RAG_TOP_K=5
RAG_AUTO_LOAD_ON_START=true
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_MODEL_PATH=

BASE_SYSTEM_PROMPT_FILE=/app/ai_service/prompts/system/base_system_prompt.md
QUESTION_REWRITE_PROMPT_FILE=/app/ai_service/prompts/system/question_rewrite_prompt.md
DECISION_PROMPT_FILE=/app/ai_service/prompts/system/decision_prompt.md
FINAL_RESPONSE_PROMPT_FILE=/app/ai_service/prompts/system/final_response_prompt.md
TOOL_REGISTRY_PROMPT_FILE=/app/ai_service/prompts/tools/tool_registry_prompt.md
WEIGHT_ANALYSIS_TOOL_PROMPT_FILE=/app/ai_service/prompts/tools/weight_analysis_llm_prompt.md

# 建议使用 JSON 数组格式，和本地 .env.example 保持一致。
TOOL_ENABLED_LIST=["weight_analysis","location_search"]
WEIGHT_ANALYSIS_LIMIT=10
